# ─────────────────────────────────────────────────────────────
# Helix — environment template. Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

# --- Gateway (Anthropic-compatible endpoint) ------------------------
HELIX_GATEWAY_PORT=4000
# The model id clients send. Keep this Helix-namespaced unless this is a
# single-operator install: the advertised id must not imply Anthropic
# affiliation. See docs/model-behavior.md.
HELIX_ADVERTISE_MODEL_ID=helix-fable-5-2
# A virtual key. When unset, one is generated and printed at startup.
HELIX_API_KEY=
HELIX_SIGNING_SECRET=change-me-to-a-long-random-string
HELIX_RPM=120
HELIX_MAX_CONCURRENT=8
HELIX_UPSTREAM_TIMEOUT_MS=300000

# --- Studio mode -----------------------------------------------------
# When set, the local model becomes the planner: it calls the MCP server's
# generation tools and Helix drives the loop. Leave empty for a plain
# model gateway.
HELIX_MCP_URL=
HELIX_MCP_TOKEN=
HELIX_MCP_TIMEOUT_MS=900000

# --- Local model (OpenAI-compatible) --------------------------------
HELIX_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
HELIX_LOCAL_MODEL=qwen3:32b

# --- Higgsfield (generation backend) --------------------------------
# Create credentials at https://console.higgsfield.ai
HELIX_HF_KEY_ID=
HELIX_HF_KEY_SECRET=
# Shared secret Higgsfield signs its webhooks with.
HELIX_WEBHOOK_SECRET=

# --- Connector mode --------------------------------------------------
# When set, the generation tools are relayed to an upstream MCP server
# (Higgsfield) instead of calling the Higgsfield API directly. The
# connected client's identity is forwarded, so the upstream sees the real
# client rather than Helix.
HELIX_UPSTREAM_MCP_URL=https://mcp.higgsfield.ai/mcp
HELIX_UPSTREAM_MCP_TOKEN=
# Higgsfield serves 2026-07-28 in _meta but no handshake.
HELIX_UPSTREAM_MCP_PROTOCOL=2026-07-28
HELIX_UPSTREAM_MCP_TIMEOUT_MS=900000

# --- MCP server ------------------------------------------------------
HELIX_MCP_PORT=4001
# The public base URL clients reach, e.g. https://helix.example
HELIX_PUBLIC_URL=http://127.0.0.1:4001
# Comma-separated Origin allowlist. Leave empty to allow any origin
# (development only).
HELIX_ALLOWED_ORIGINS=
# Where MCP accounts live. Create one with: helix user add <email>
HELIX_USERS_FILE=./data/users.json
# A bootstrap account, created at startup when it does not already exist.
HELIX_BOOTSTRAP_USER_EMAIL=
HELIX_BOOTSTRAP_USER_PASSWORD=

# --- Quota -----------------------------------------------------------
# Shared quota state. Without Redis, limits are per process.
HELIX_REDIS_URL=
# Daily media spend budget per tenant, in USD.
HELIX_MEDIA_BUDGET_USD=10
