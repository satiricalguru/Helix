{
  "name": "helix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Anthropic-compatible gateway + Higgsfield-backed MCP server",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:gateway": "tsx watch packages/gateway/src/main.ts",
    "dev:mcp": "tsx watch packages/mcp-server/src/main.ts",
    "cli": "tsx apps/cli/src/cli.ts",
    "doctor": "tsx apps/cli/src/cli.ts doctor"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  }
}
